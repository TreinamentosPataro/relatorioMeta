# ---------------------------------------------------------------------------
# Copie para .env e preencha. NUNCA versione o .env nem as credenciais.
# ---------------------------------------------------------------------------

# --- Obrigatórias: Meta (Marketing API) ---
# ID do app criado em developers.facebook.com
META_APP_ID=
# Segredo do app (App Dashboard > Configurações > Básico)
META_APP_SECRET=
# Access token de longa duração com permissão ads_read
META_ACCESS_TOKEN=
# ID da conta de anúncios, com o prefixo act_ (ex.: act_1234567890)
META_AD_ACCOUNT_ID=

# --- Obrigatórias: Google Sheets ---
# Caminho para o JSON da service account OU o próprio JSON em uma linha.
# A service account precisa ter acesso de edição à planilha.
GOOGLE_SERVICE_ACCOUNT_JSON=
# ID da planilha (o trecho entre /d/ e /edit na URL)
SPREADSHEET_ID=

# --- Opcionais (valores abaixo são os defaults) ---
# Quantos dias retroativos coletar a cada execução
LOOKBACK_DAYS=7
# Fuso da conta de anúncios (usado para janelas de data)
ACCOUNT_TIMEZONE=America/Sao_Paulo
# Aba que recebe os dados brutos
RAW_SHEET_NAME=Meta ADS
# Aba que recebe as métricas derivadas
DERIVED_SHEET_NAME=Meta ADS - Métricas
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# true = coleta e loga, mas não escreve na planilha
DRY_RUN=false
